{
  "name": "ilmpdf",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Local-only PDF toolkit. All processing happens in the browser; files never leave the device.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "make-test-pdfs": "node scripts/make-test-pdfs.mjs",
    "audit:deps": "npm audit --audit-level=low && npm audit signatures",
    "verify": "npm run check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "mupdf": "1.28.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "tesseract-wasm": "0.11.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "file:vendor/stubs/napi-rs-canvas",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.4",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@napi-rs/canvas": "$@napi-rs/canvas"
  }
}
